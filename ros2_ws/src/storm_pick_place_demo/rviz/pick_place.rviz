        Alpha: 1
        Show Axes: false
        Show Trail: false
    Mass Properties:
      Inertia: false
      Mass: false
    Name: Environment
    TF Prefix: ''
    Update Interval: 0
    Value: false
    Visual Enabled: true
  - Class: rviz_default_plugins/TF
    Enabled: false
    Frame Timeout: 15
    Frames:
      All Enabled: true
    Marker Scale: 0.5
    Name: TF
    Show Arrows: true
    Show Axes: true
    Show Names: false

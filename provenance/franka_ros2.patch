 #include <ignition/msgs/wrench.pb.h>
 
 #include <limits>
+#include <fstream>
+#include <cstdlib>
 #include <map>
 #include <memory>
 #include <string>
@@ -736,7 +738,7 @@ hardware_interface::return_type IgnitionSystem::perform_command_mode_switch(
 }
 
 hardware_interface::return_type IgnitionSystem::write(
-  const rclcpp::Time & /*time*/,
+  const rclcpp::Time & time,
   const rclcpp::Duration & /*period*/)
 {
   // Assuming there are 7 joints and gravity_earth is defined
@@ -910,6 +912,31 @@ hardware_interface::return_type IgnitionSystem::write(
     }
   }
 
+  // Opt-in simulator instrumentation, without changing any command or physics.
+  // Binary float64 rows: time, q[7], dq[7], KDL gravity[7], hardware command[7],
+  // exact JointForceCmd[7], measured transmitted wrench[7].
+  static const char * benchmark_log_path = std::getenv("HUMAN_BENCHMARK_ACTUATOR_LOG");
+  static std::ofstream benchmark_log;
+  static size_t benchmark_log_rows = 0;
+  if (benchmark_log_path != nullptr && this->dataPtr->joints_.size() >= 7) {
+    if (!benchmark_log.is_open()) {
+      benchmark_log.open(benchmark_log_path, std::ios::binary | std::ios::out);
+    }
+    std::array<double, 43> row{};
+    row[0] = time.seconds();
+    for (size_t i = 0; i < 7; ++i) {
+      const auto & joint = this->dataPtr->joints_[i];
+      row[1+i] = joint.joint_position;
+      row[8+i] = joint.joint_velocity;
+      row[15+i] = joint_efforts[i];
+      row[22+i] = joint.joint_effort_cmd;
+      const auto command = this->dataPtr->ecm->Component<ignition::gazebo::components::JointForceCmd>(joint.sim_joint);
+      row[29+i] = command && !command->Data().empty() ? command->Data()[0] : std::numeric_limits<double>::quiet_NaN();
+      row[36+i] = joint.joint_effort;
+    }
+    benchmark_log.write(reinterpret_cast<const char *>(row.data()), sizeof(row));
+    if (++benchmark_log_rows % 100 == 0) { benchmark_log.flush(); }
+  }
   return hardware_interface::return_type::OK;
 }
 }  // namespace ign_ros2_control

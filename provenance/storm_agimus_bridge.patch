+    # pick_place_task_manager_node's *active* pick/place target (pp_pick_object/
+    # pp_place_target), plus tower_task_manager_node's other cubes waiting to be picked or
+    # already stacked (pp_tower_pending/pp_tower_stacked). All four are the *same kind* of
+    # object -- a task cube -- just in different states; which specific one is currently held
+    # by the gripper (and therefore excluded) is handled separately, by
+    # _filter_box_world_params, not by this categorization. All of them route to the
+    # dedicated box_collision cost, never the general primitive_collision one.
+    _BOX_OBJECT_NAMESPACES = ("pp_pick_object", "pp_place_target", "pp_tower_pending", "pp_tower_stacked")
+
+    # Static (non-marker) entries from collision_primitives_3d.yml that should also route to
+    # box_collision instead of the general primitive_collision bucket -- matched by exact name,
+    # the same way the static "table" entry is exact-name-matched to the table bucket below.
+    # "poto_l"/"poto_r" are the two floor-to-ceiling pole obstacles.
+    _STATIC_BOX_OBJECT_NAMES = ("poto_l", "poto_r")
+
+    def _partition_world_params(self, world_params: dict) -> tuple[dict, dict, dict]:
+        """Splits a fully-resolved world_params dict (as returned by _build_world_params) into
+        three disjoint parts: (general, box, table).
+
+        - box: entries merged from the _BOX_OBJECT_NAMESPACES marker namespaces, plus the
+          static _STATIC_BOX_OBJECT_NAMES entries -- feeds the dedicated box_collision cost
+          instead of the general one.
+        - table: the static "table" primitive from collision_primitives_3d.yml -- feeds the
+          dedicated table_collision cost instead of the general one.
+        - general: everything else, unchanged primitive_collision coverage.
+
+        Name-substring partitioning is safe here because _merge_marker_array_into_world
+        deterministically builds names as f"{name_prefix}_{marker.ns}_{marker.id}", and the
+        base world's static table/pole entries are always keyed exactly by their yaml name.
+        """
+        coll_objs = world_params.get("world_model", {}).get("coll_objs", {})
+        cubes = dict(coll_objs.get("cube", {}))
+        spheres = dict(coll_objs.get("sphere", {}))
+
+        def category(name: str) -> str:
+            if name in self._STATIC_BOX_OBJECT_NAMES:
+                return "box"
+            if any(f"_{ns}_" in name for ns in self._BOX_OBJECT_NAMESPACES):
+                return "box"
+            if name == "table":
+                return "table"
+            return "general"

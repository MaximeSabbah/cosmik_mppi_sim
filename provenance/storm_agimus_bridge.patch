+    def _clamp_q_des_to_joint_limits(self, q_des: np.ndarray) -> np.ndarray:
+        """Hard backstop: never publish a reference outside the robot's actual joint position
+        limits, regardless of what STORM's soft state_bound cost (or shifted-CaT) decided.
+        A guarantee, not a preference -- independent of and in addition to state_bound, since
+        a large soft-cost weight can still be outweighed by other costs in MPPI's
+        softmax-weighted average (see the "state_bound not winning" discussion this was added
+        for). Joint order is derived from self._moving_joint_names (matches q_des's own
+        indexing) via the trailing joint number, so it's correct regardless of arm_id naming
+        (fer_jointN / panda_jointN / fr3_jointN all share identical physical limits).
+        """
+        if not self._moving_joint_names or len(self._moving_joint_names) != q_des.size:
+            return q_des
+
+        if self._joint_limit_lower is None or self._joint_limit_upper is None:
+            lower = np.zeros(q_des.size, dtype=np.float64)
+            upper = np.zeros(q_des.size, dtype=np.float64)
+            for i, name in enumerate(self._moving_joint_names):
+                m = re.search(r"joint(\d+)$", name)
+                if not m:
+                    self.get_logger().warn(
+                        f"Cannot derive joint number from '{name}'; skipping hard joint-limit clamp.",
+                        throttle_duration_sec=5.0,
+                    )
+                    return q_des
+                idx = int(m.group(1)) - 1
+                if idx < 0 or idx >= len(_FRANKA_JOINT_LOWER):
+                    self.get_logger().warn(
+                        f"Joint index {idx + 1} from '{name}' out of range; skipping hard joint-limit clamp.",
+                        throttle_duration_sec=5.0,
+                    )
+                    return q_des
+                lower[i] = _FRANKA_JOINT_LOWER[idx]
+                upper[i] = _FRANKA_JOINT_UPPER[idx]
+            self._joint_limit_lower = lower
+            self._joint_limit_upper = upper
+
+        return np.clip(q_des, self._joint_limit_lower, self._joint_limit_upper)
+
+    def _guard_joint_limit_reference(self, q_des, dq_des, ddq_des):
+        """Keep the published position, velocity and acceleration consistent at limits.
+
+        A position-only clip can still command outward velocity and feedforward torque.
+        This was observed on joint 7 during the physical COSMIK replay trial.
+        The inset leaves tracking/braking room; it does not bound measured motion.
+        """
+        q_des = self._clamp_q_des_to_joint_limits(q_des)
+        margin = float(self.get_parameter("joint_limit_reference_margin_rad").value)
+        if not np.isfinite(margin) or margin < 0:
+            raise ValueError("joint_limit_reference_margin_rad must be finite and nonnegative")
+        if (margin == 0 or not self._armed or self._goal_pose_msg is None
+                or self._joint_limit_lower is None or self._joint_limit_upper is None):
+            return q_des, dq_des, ddq_des
+        lower = self._joint_limit_lower + margin
+        upper = self._joint_limit_upper - margin
+        if np.any(lower >= upper):
+            raise ValueError("joint_limit_reference_margin_rad leaves no joint range")
+        q_des = np.clip(q_des, lower, upper)
+        at_lower, at_upper = q_des <= lower, q_des >= upper
+        dq_des = np.asarray(dq_des, dtype=np.float64).copy()
+        ddq_des = np.asarray(ddq_des, dtype=np.float64).copy()
+        dq_des[(at_lower & (dq_des < 0)) | (at_upper & (dq_des > 0))] = 0.0
+        ddq_des[(at_lower & (ddq_des < 0)) | (at_upper & (ddq_des > 0))] = 0.0
+        return q_des, dq_des, ddq_des
